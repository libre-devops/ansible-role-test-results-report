# Test image: the distribution's minimal image with Python for Ansible's fact gathering.
FROM {{ item.image }}

{% if 'ubi' in item.image %}
RUN microdnf -y install python3 && microdnf clean all
{% else %}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
{% endif %}
