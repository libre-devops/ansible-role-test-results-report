{#-
  The human-readable report. Rendered by files/test_results_report.py, not by Ansible's template
  module, with these filters: cell (one table cell), text (escaped text), code (inline code),
  block (a fenced block), plural, cut (output shortened to output_limit) and number.
  Copy it and point test_results_report_markdown_template at your copy to change the layout;
  the data is the JSON report, as report, documented in the README.
-#}
{%- set s = report.summary -%}
{%- set show_label = report.hosts | map(attribute='label') | list != report.hosts | map(attribute='host') | list -%}
{%- macro platform(host) -%}
{%- set f = host.facts -%}
{{ [f.get('distribution', ''), f.get('distribution_version', '')] | select | join(' ') }}{{ (' (' ~ f.architecture ~ ')') if f.get('architecture') }}
{%- endmacro -%}
{%- macro check_name(result) -%}
{{ result.name | cell }} {{ result.id | code }}
{%- endmacro -%}
{%- macro metrics(result) -%}
{{ result.metrics | dictsort | map('join', '=') | join(', ') | cell }}
{%- endmacro -%}
